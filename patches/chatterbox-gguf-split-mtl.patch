+bool load_model_gguf_mtl_split(const std::string & t3_path,
+                               chatterbox_model & model,
+                               int requested_ctx,
+                               int n_gpu_layers) {
+    extern int g_log_verbose;
+    const std::string codec_path = find_codec_companion(t3_path);
+    if (codec_path.empty()) {
+        fprintf(stderr, "load_model_gguf_mtl_split: no *codec*.gguf next to %s\n",
+                t3_path.c_str());
+        return false;
+    }
+    fprintf(stderr, "load_model_gguf_mtl_split: t3=%s codec=%s\n",
+            t3_path.c_str(), codec_path.c_str());
+
+    ggml_context * t3_tmp = nullptr;
+    ggml_context * codec_tmp = nullptr;
+    gguf_init_params gp = { /*.no_alloc=*/ false, /*.ctx=*/ &t3_tmp };
+    gguf_context * t3_ctx = gguf_init_from_file(t3_path.c_str(), gp);
+    gp.ctx = &codec_tmp;
+    gguf_context * codec_ctx = gguf_init_from_file(codec_path.c_str(), gp);
+    if (!t3_ctx || !codec_ctx) {
+        fprintf(stderr, "load_model_gguf_mtl_split: failed to open split GGUFs\n");
+        if (t3_ctx) gguf_free(t3_ctx);
+        if (codec_ctx) gguf_free(codec_ctx);
+        if (t3_tmp) ggml_free(t3_tmp);
+        if (codec_tmp) ggml_free(codec_tmp);
+        return false;
+    }
+
+    try {
+        auto & hp = model.hparams;
+        hp.variant = CHBX_VARIANT_MTL;
+        hp.n_text_vocab = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.text_vocab_size", 2454);
+        hp.n_speech_vocab = 8194;
+        {
+            const int64_t id = gguf_find_key(codec_ctx, "codec.lm.codebook_sizes");
+            if (id >= 0 && gguf_get_arr_n(codec_ctx, id) >= 1) {
+                hp.n_speech_vocab = (int32_t) ((const uint32_t *) gguf_get_arr_data(codec_ctx, id))[0];
+            }
+        }
+        hp.start_speech_token = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.start_speech_token", 6561);
+        hp.stop_speech_token  = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.stop_speech_token", 6562);
+        hp.start_text_token   = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.start_text_token", 255);
+        hp.stop_text_token    = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.stop_text_token", 0);
+        hp.speaker_embed_size = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.speaker_embed_dim", 256);
+        hp.max_text_tokens    = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.max_text_tokens", 2048);
+        hp.max_speech_tokens  = (int32_t) kv_u32(codec_ctx, "codec.lm.chatterbox.max_speech_tokens", 4096);
+        hp.speech_cond_prompt_len = 150;
+        hp.cond_prompt_len    = 150;
+        hp.perceiver_queries  = 32;
+        hp.perceiver_heads    = 4;
+        hp.emotion_adv        = kv_bool(codec_ctx, "codec.lm.chatterbox.has_emotion_cond", true);
+        hp.n_layer = (int32_t) kv_u32(t3_ctx, "llama.block_count", 30);
+        hp.n_embd  = (int32_t) kv_u32(t3_ctx, "llama.embedding_length", 1024);
+        hp.n_head  = (int32_t) kv_u32(t3_ctx, "llama.attention.head_count", 16);
+        hp.n_kv_head = (int32_t) kv_u32(t3_ctx, "llama.attention.head_count_kv", 16);
+        hp.head_dim = (int32_t) kv_u32(t3_ctx, "llama.attention.key_length", 64);
+        hp.intermediate_size = (int32_t) kv_u32(t3_ctx, "llama.feed_forward_length", 4096);
+        hp.eps = kv_f32(t3_ctx, "llama.attention.layer_norm_rms_epsilon", 1e-5f);
+        hp.rope_theta = kv_f32(t3_ctx, "llama.rope.freq_base", 500000.0f);
+        hp.rope_scale_factor = 8.0f;
+        hp.rope_low_freq = 1.0f;
+        hp.rope_high_freq = 4.0f;
+        hp.rope_orig_max_pos = 8192;
+        hp.n_ctx = hp.max_text_tokens + hp.max_speech_tokens + 4;
+        if (requested_ctx > 0) hp.n_ctx = std::min(hp.n_ctx, requested_ctx);
+
+        model.mtl_tokenizer_json = build_tokenizer_json(codec_ctx);
+        model.mtl_languages = {
+            "ar","da","de","el","en","es","fi","fr","he","hi",
+            "it","ja","ko","ms","nl","no","pl","pt","ru","sv","sw","tr","zh"
+        };
+
+        struct Src {
+            ggml_context * tmp;
+            std::string src_name;
+            std::string dst_name;
+        };
+        std::vector<Src> srcs;
+        auto collect = [&](gguf_context * g, ggml_context * tmp) {
+            const int64_t n = gguf_get_n_tensors(g);
+            for (int64_t i = 0; i < n; ++i) {
+                const char * name = gguf_get_tensor_name(g, i);
+                std::string dst;
+                if (!remap_t3_name(name, dst)) continue;
+                srcs.push_back({tmp, name, dst});
+            }
+        };
+        collect(t3_ctx, t3_tmp);
+        collect(codec_ctx, codec_tmp);
+
+        model.backend = init_backend(n_gpu_layers);
+        const size_t extra = 4;
+        ggml_init_params p = { ggml_tensor_overhead() * (srcs.size() + extra), nullptr, true };
+        model.ctx_w = ggml_init(p);
+        if (!model.ctx_w) throw std::runtime_error("split-mtl ggml_init failed");
+
+        auto new_f32_like = [&](const ggml_tensor * src) -> ggml_tensor * {
+            // Match the GGUF tensor's rank via ggml_n_dims(). Collapsing a
+            // trailing-1 3D (e.g. perceiver.queries [1024,32,1]) to 2D, or
+            // allocating ggml_new_tensor(4, ne) for a 1D/2D weight, makes
+            // later views/get_rows compute a nbytes that does not match
+            // the allocated buffer (ggml-backend.cpp:307).
+            switch (ggml_n_dims(src)) {
+                case 1: return ggml_new_tensor_1d(model.ctx_w, GGML_TYPE_F32, src->ne[0]);
+                case 2: return ggml_new_tensor_2d(model.ctx_w, GGML_TYPE_F32, src->ne[0], src->ne[1]);
+                case 3: return ggml_new_tensor_3d(model.ctx_w, GGML_TYPE_F32,
+                                                  src->ne[0], src->ne[1], src->ne[2]);
+                default: return ggml_new_tensor_4d(model.ctx_w, GGML_TYPE_F32,
+                                                   src->ne[0], src->ne[1], src->ne[2], src->ne[3]);
+            }
+        };
+
+        for (const auto & s : srcs) {
+            ggml_tensor * src = ggml_get_tensor(s.tmp, s.src_name.c_str());
+            if (!src) throw std::runtime_error("split-mtl src missing: " + s.src_name);
+            ggml_tensor * dst = (src->type == GGML_TYPE_F16)
+                ? new_f32_like(src)
+                : ggml_dup_tensor(model.ctx_w, src);
+            ggml_set_name(dst, s.dst_name.c_str());
+            model.tensors[s.dst_name] = dst;
+        }
+
+        ggml_tensor * speaker = ggml_new_tensor_1d(model.ctx_w, GGML_TYPE_F32, hp.speaker_embed_size);
+        ggml_set_name(speaker, "chatterbox/builtin/speaker_emb");
+        model.tensors["chatterbox/builtin/speaker_emb"] = speaker;
+        ggml_tensor * cond_tok = ggml_new_tensor_1d(model.ctx_w, GGML_TYPE_I32, hp.cond_prompt_len);
+        ggml_set_name(cond_tok, "chatterbox/builtin/cond_prompt_speech_tokens");
+        model.tensors["chatterbox/builtin/cond_prompt_speech_tokens"] = cond_tok;
+        const int half_hd = hp.head_dim / 2;
+        ggml_tensor * freq_factors = ggml_new_tensor_1d(model.ctx_w, GGML_TYPE_F32, half_hd);
+        ggml_set_name(freq_factors, "rope_freq_factors");
+        model.rope_freq_factors = freq_factors;
+
+        model.buffer_w = ggml_backend_alloc_ctx_tensors(model.ctx_w, model.backend);
+        if (!model.buffer_w) throw std::runtime_error("split-mtl weights alloc failed");
+
+        for (const auto & s : srcs) {
+            ggml_tensor * src = ggml_get_tensor(s.tmp, s.src_name.c_str());
+            ggml_tensor * dst = model.tensors[s.dst_name];
+            if (dst->type == GGML_TYPE_F32 && src->type == GGML_TYPE_F16) {
+                const size_t n = (size_t) ggml_nelements(src);
+                std::vector<float> tmp(n);
+                const uint16_t * in = (const uint16_t *) ggml_get_data(src);
+                for (size_t i = 0; i < n; ++i) {
+                    uint16_t h = in[i];
+                    uint32_t sign = ((uint32_t)(h >> 15)) << 31;
+                    uint32_t exp  = (h >> 10) & 0x1f;
+                    uint32_t mant = h & 0x3ff;
+                    uint32_t bits;
+                    if (exp == 0) {
+                        bits = sign;
+                    } else if (exp == 31) {
+                        bits = sign | 0x7f800000u | (mant << 13);
+                    } else {
+                        bits = sign | ((exp + (127 - 15)) << 23) | (mant << 13);
+                    }
+                    std::memcpy(&tmp[i], &bits, 4);
+                }
+                ggml_backend_tensor_set(dst, tmp.data(), 0, tmp.size() * sizeof(float));
+            } else {
+                ggml_backend_tensor_set(dst, ggml_get_data(src), 0, ggml_nbytes(src));
+            }
+        }
+
+        {
+            const int64_t sid = gguf_find_key(codec_ctx, "codec.lm.chatterbox.builtin.speaker_emb");
+            std::vector<float> se((size_t) hp.speaker_embed_size, 0.f);
+            if (sid >= 0) {
+                const size_t n = std::min((size_t) gguf_get_arr_n(codec_ctx, sid), se.size());
+                const float * d = (const float *) gguf_get_arr_data(codec_ctx, sid);
+                if (d) std::memcpy(se.data(), d, n * sizeof(float));
+            }
+            ggml_backend_tensor_set(speaker, se.data(), 0, se.size() * sizeof(float));
+        }
+        {
+            const int64_t cid = gguf_find_key(codec_ctx, "codec.lm.chatterbox.builtin.cond_prompt_speech_tokens");
+            std::vector<int32_t> ct((size_t) hp.cond_prompt_len, 0);
+            if (cid >= 0) {
+                const size_t n = std::min((size_t) gguf_get_arr_n(codec_ctx, cid), ct.size());
+                const uint32_t * d = (const uint32_t *) gguf_get_arr_data(codec_ctx, cid);
+                if (d) {
+                    for (size_t i = 0; i < n; ++i) ct[i] = (int32_t) d[i];
+                }
+            }
+            ggml_backend_tensor_set(cond_tok, ct.data(), 0, ct.size() * sizeof(int32_t));
+        }
+        {
+            std::vector<float> ff = rope_freq_factors(
+                hp.head_dim, hp.rope_theta, hp.rope_scale_factor,
+                hp.rope_low_freq, hp.rope_high_freq, hp.rope_orig_max_pos);
+            ggml_backend_tensor_set(freq_factors, ff.data(), 0, ff.size() * sizeof(float));
+        }
+
+        model.text_emb        = must(model, "chatterbox/text_emb");
+        model.speech_emb      = must(model, "chatterbox/speech_emb");
+        model.text_pos_emb    = must(model, "chatterbox/text_pos_emb");
+        model.speech_pos_emb  = must(model, "chatterbox/speech_pos_emb");
+        model.text_head       = must(model, "chatterbox/text_head");
+        model.speech_head     = must(model, "chatterbox/speech_head");
+        model.norm_g          = must(model, "model/norm/g");
+        model.cond_spkr_w     = must(model, "chatterbox/cond_spkr/w");
+        model.cond_spkr_b     = must(model, "chatterbox/cond_spkr/b");
+        model.emotion_adv_w   = must(model, "chatterbox/emotion_adv_fc/w");
+        model.perceiver.pre_attention_query = must(model, "chatterbox/perceiver/pre_attention_query");
+        model.perceiver.norm_g = must(model, "chatterbox/perceiver/attn/norm/g");
+        model.perceiver.norm_b = must(model, "chatterbox/perceiver/attn/norm/b");
+        model.perceiver.to_q_w = must(model, "chatterbox/perceiver/attn/to_q/w");
+        model.perceiver.to_q_b = must(model, "chatterbox/perceiver/attn/to_q/b");
+        model.perceiver.to_k_w = must(model, "chatterbox/perceiver/attn/to_k/w");
+        model.perceiver.to_k_b = must(model, "chatterbox/perceiver/attn/to_k/b");
+        model.perceiver.to_v_w = must(model, "chatterbox/perceiver/attn/to_v/w");
+        model.perceiver.to_v_b = must(model, "chatterbox/perceiver/attn/to_v/b");
+        model.perceiver.proj_out_w = must(model, "chatterbox/perceiver/attn/proj_out/w");
+        model.perceiver.proj_out_b = must(model, "chatterbox/perceiver/attn/proj_out/b");
+        model.builtin_speaker_emb        = speaker;
+        model.builtin_cond_prompt_tokens = cond_tok;
+
+        model.layers_mtl.resize(hp.n_layer);
+        for (int i = 0; i < hp.n_layer; ++i) {
+            auto & l = model.layers_mtl[i];
+            const std::string lp = "model/h" + std::to_string(i);
+            l.ln_attn_g = must(model, (lp + "/ln_attn/g").c_str());
+            l.ln_mlp_g  = must(model, (lp + "/ln_mlp/g").c_str());
+            l.wq = must(model, (lp + "/attn/q/w").c_str());
+            l.wk = must(model, (lp + "/attn/k/w").c_str());
+            l.wv = must(model, (lp + "/attn/v/w").c_str());
+            l.wo = must(model, (lp + "/attn/o/w").c_str());
+            l.mlp_gate = must(model, (lp + "/mlp/gate/w").c_str());
+            l.mlp_up   = must(model, (lp + "/mlp/up/w").c_str());
+            l.mlp_down = must(model, (lp + "/mlp/down/w").c_str());
+        }
+
+        ggml_init_params kv_params = { ggml_tensor_overhead() * 4, nullptr, true };
+        model.ctx_kv = ggml_init(kv_params);
+        const int64_t kv_elements_b2 =
+            (int64_t) 2 * hp.head_dim * hp.n_kv_head * hp.n_ctx * hp.n_layer;
+        model.memory_k = ggml_new_tensor_1d(model.ctx_kv, GGML_TYPE_F32, kv_elements_b2);
+        model.memory_v = ggml_new_tensor_1d(model.ctx_kv, GGML_TYPE_F32, kv_elements_b2);
+        model.memory_k_uncond = nullptr;
+        model.memory_v_uncond = nullptr;
+        model.buffer_kv = ggml_backend_alloc_ctx_tensors(model.ctx_kv, model.backend);
+        if (!model.buffer_kv) throw std::runtime_error("split-mtl KV alloc failed");
+
+        if (!ggml_backend_is_cpu(model.backend)) {
+            const int n_embd = hp.n_embd;
+            ggml_init_params sp = { ggml_tensor_overhead() * (size_t) (2 * hp.n_layer + 4), nullptr, true };
+            model.ctx_stack = ggml_init(sp);
+            if (!model.ctx_stack) throw std::runtime_error("split-mtl stack init failed");
+            for (int i = 0; i < hp.n_layer; ++i) {
+                auto & l = model.layers_mtl[i];
+                if (l.wq->type != l.wk->type || l.wq->type != l.wv->type) {
+                    l.wqkv = nullptr;
+                    continue;
+                }
+                l.wqkv = ggml_new_tensor_2d(model.ctx_stack, l.wq->type, n_embd, 3 * n_embd);
+            }
+            model.buffer_stack = ggml_backend_alloc_ctx_tensors(model.ctx_stack, model.backend);
+            if (!model.buffer_stack) throw std::runtime_error("split-mtl stack alloc failed");
+            t3_stack_register(model.buffer_stack, model.ctx_stack);
+            size_t scratch_bytes = 0;
+            for (int i = 0; i < hp.n_layer; ++i) {
+                auto & l = model.layers_mtl[i];
+                if (!l.wqkv) continue;
+                scratch_bytes = std::max({scratch_bytes, ggml_nbytes(l.wq), ggml_nbytes(l.wk), ggml_nbytes(l.wv)});
+            }
+            std::vector<char> scratch(scratch_bytes);
+            for (int i = 0; i < hp.n_layer; ++i) {
+                auto & l = model.layers_mtl[i];
+                if (!l.wqkv) continue;
+                size_t off = 0;
+                auto copy_into = [&](ggml_tensor * src, ggml_tensor * dst) {
+                    const size_t nb = ggml_nbytes(src);
+                    ggml_backend_tensor_get(src, scratch.data(), 0, nb);
+                    ggml_backend_tensor_set(dst, scratch.data(), off, nb);
+                    off += nb;
+                };
+                copy_into(l.wq, l.wqkv);
+                copy_into(l.wk, l.wqkv);
+                copy_into(l.wv, l.wqkv);
+            }
+        }
+
+        auto dump_t = [](const char * tag, const ggml_tensor * t) {
+            if (!t) { fprintf(stderr, "split-mtl %s: null\n", tag); return; }
+            fprintf(stderr,
+                    "split-mtl %s: type=%d n_dims=%d ne=[%lld,%lld,%lld,%lld] nbytes=%zu\n",
+                    tag, (int) t->type, ggml_n_dims(t),
+                    (long long) t->ne[0], (long long) t->ne[1],
+                    (long long) t->ne[2], (long long) t->ne[3],
+                    ggml_nbytes(t));
+        };
+        dump_t("text_emb", model.text_emb);
+        dump_t("speech_emb", model.speech_emb);
+        dump_t("text_pos_emb", model.text_pos_emb);
+        dump_t("speech_pos_emb", model.speech_pos_emb);
+        dump_t("speech_head", model.speech_head);
+        dump_t("perceiver_q", model.perceiver.pre_attention_query);
+        dump_t("cond_spkr_w", model.cond_spkr_w);
+        fprintf(stderr, "load_model_gguf_mtl_split: ctx=%d embd=%d layers=%d text_vocab=%d speech_vocab=%d tok=%zu\n",
+                hp.n_ctx, hp.n_embd, hp.n_layer, hp.n_text_vocab, hp.n_speech_vocab,
+                model.mtl_tokenizer_json.size());
+    } catch (const std::exception & e) {
+        fprintf(stderr, "load_model_gguf_mtl_split: %s\n", e.what());
+        gguf_free(t3_ctx);
+        gguf_free(codec_ctx);
+        if (t3_tmp) ggml_free(t3_tmp);
+        if (codec_tmp) ggml_free(codec_tmp);
+        return false;
+    }
+
+    gguf_free(t3_ctx);
+    gguf_free(codec_ctx);
+    if (t3_tmp) ggml_free(t3_tmp);
+    if (codec_tmp) ggml_free(codec_tmp);
+    return true;
+}
+
+} // namespace tts_cpp::chatterbox::detail
