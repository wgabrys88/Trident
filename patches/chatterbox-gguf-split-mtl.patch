+std::string build_tokenizer_json(const gguf_context * codec) {
+    const int64_t tk = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.tokens");
+    const int64_t mk = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.merges");
+    const int64_t ak = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.added");
+    const int64_t uk = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.unk_token");
+    if (tk < 0 || mk < 0) {
+        throw std::runtime_error("split-mtl: codec missing tokenizer tokens/merges");
+    }
+    const char * unk = "[UNK]";
+    if (uk >= 0) {
+        const char * u = gguf_get_val_str(codec, uk);
+        if (u) unk = u;
+    }
+    std::ostringstream js;
+    js << "{\"model\":{\"type\":\"BPE\",\"unk_token\":\"" << json_escape(unk) << "\",\"vocab\":{";
+    const size_t ntok = gguf_get_arr_n(codec, tk);
+    for (size_t i = 0; i < ntok; ++i) {
+        const char * t = gguf_get_arr_str(codec, tk, i);
+        if (!t) continue;
+        if (i) js << ',';
+        js << '"' << json_escape(t) << "\":" << i;
+    }
+    js << "},\"merges\":[";
+    const size_t nmer = gguf_get_arr_n(codec, mk);
+    for (size_t i = 0; i < nmer; ++i) {
+        const char * t = gguf_get_arr_str(codec, mk, i);
+        if (!t) continue;
+        if (i) js << ',';
+        js << '"' << json_escape(t) << '"';
+    }
+    js << "]},\"added_tokens\":[";
+    bool first = true;
+    auto emit_added = [&](const std::string & content, int32_t id) {
+        if (!first) js << ',';
+        first = false;
+        js << "{\"content\":\"" << json_escape(content) << "\",\"id\":" << id << '}';
+    };
+    emit_added("[STOP]", (int32_t) kv_u32(codec, "codec.lm.chatterbox.stop_text_token", 0));
+    emit_added("[START]", (int32_t) kv_u32(codec, "codec.lm.chatterbox.start_text_token", 255));
+    emit_added("[UNK]", 1);
+    emit_added("[SPACE]", 2);
+    if (ak >= 0 && gguf_get_kv_type(codec, ak) == GGUF_TYPE_STRING) {
+        const char * added = gguf_get_val_str(codec, ak);
+        if (added) {
+            std::string s = added;
+            size_t pos = 0;
+            while (pos < s.size()) {
+                size_t nl = s.find('\n', pos);
+                if (nl == std::string::npos) nl = s.size();
+                std::string line = s.substr(pos, nl - pos);
+                if (!line.empty() && line.back() == '\r') line.pop_back();
+                // "[STOP]0"
+                size_t i = line.size();
+                while (i > 0 && std::isdigit((unsigned char)line[i - 1])) --i;
+                if (i > 0 && i < line.size()) {
+                    if (!first) js << ',';
+                    first = false;
+                    js << "{\"content\":\"" << json_escape(line.substr(0, i))
+                       << "\",\"id\":" << line.substr(i) << '}';
+                }
+                pos = nl + 1;
+            }
+        }
+    }
+    js << "]}";
+    return js.str();
+}
