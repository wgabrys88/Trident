+bool remap_t3_name(const char * src, std::string & dst) {
+    const std::string n = src;
+    if (n == "output_norm.weight") { dst = "model/norm/g"; return true; }
+    if (n.rfind("blk.", 0) == 0) {
+        const size_t p2 = n.find('.', 4);
+        if (p2 == std::string::npos) return false;
+        const int idx = std::atoi(n.c_str() + 4);
+        const std::string rest = n.substr(p2 + 1);
+        char buf[80];
+        auto set = [&](const char * fmt) {
+            std::snprintf(buf, sizeof(buf), fmt, idx);
+            dst = buf;
+            return true;
+        };
+        if (rest == "attn_norm.weight")    return set("model/h%d/ln_attn/g");
+        if (rest == "ffn_norm.weight")     return set("model/h%d/ln_mlp/g");
+        if (rest == "attn_q.weight")       return set("model/h%d/attn/q/w");
+        if (rest == "attn_k.weight")       return set("model/h%d/attn/k/w");
+        if (rest == "attn_v.weight")       return set("model/h%d/attn/v/w");
+        if (rest == "attn_output.weight")  return set("model/h%d/attn/o/w");
+        if (rest == "ffn_gate.weight")     return set("model/h%d/mlp/gate/w");
+        if (rest == "ffn_up.weight")       return set("model/h%d/mlp/up/w");
+        if (rest == "ffn_down.weight")     return set("model/h%d/mlp/down/w");
+        return false;
+    }
+    static const char * kMap[][2] = {
+        {"lm.chatterbox.text_emb.weight", "chatterbox/text_emb"},
+        {"lm.chatterbox.text_head.weight", "chatterbox/text_head"},
+        {"lm.chatterbox.text_pos_emb.weight", "chatterbox/text_pos_emb"},
+        {"lm.chatterbox.speech_pos_emb.weight", "chatterbox/speech_pos_emb"},
+        {"lm.audio_embd_0.weight", "chatterbox/speech_emb"},
+        {"lm.heads_0.weight", "chatterbox/speech_head"},
+        {"lm.chatterbox.cond.spkr_enc.weight", "chatterbox/cond_spkr/w"},
+        {"lm.chatterbox.cond.spkr_enc.bias", "chatterbox/cond_spkr/b"},
+        {"lm.chatterbox.cond.emotion_adv_fc.weight", "chatterbox/emotion_adv_fc/w"},
+        {"lm.chatterbox.cond.perceiver.queries", "chatterbox/perceiver/pre_attention_query"},
+        {"lm.chatterbox.cond.perceiver.norm.weight", "chatterbox/perceiver/attn/norm/g"},
+        {"lm.chatterbox.cond.perceiver.norm.bias", "chatterbox/perceiver/attn/norm/b"},
+        {"lm.chatterbox.cond.perceiver.to_q.weight", "chatterbox/perceiver/attn/to_q/w"},
+        {"lm.chatterbox.cond.perceiver.to_q.bias", "chatterbox/perceiver/attn/to_q/b"},
+        {"lm.chatterbox.cond.perceiver.to_k.weight", "chatterbox/perceiver/attn/to_k/w"},
+        {"lm.chatterbox.cond.perceiver.to_k.bias", "chatterbox/perceiver/attn/to_k/b"},
+        {"lm.chatterbox.cond.perceiver.to_v.weight", "chatterbox/perceiver/attn/to_v/w"},
+        {"lm.chatterbox.cond.perceiver.to_v.bias", "chatterbox/perceiver/attn/to_v/b"},
+        {"lm.chatterbox.cond.perceiver.proj_out.weight", "chatterbox/perceiver/attn/proj_out/w"},
+        {"lm.chatterbox.cond.perceiver.proj_out.bias", "chatterbox/perceiver/attn/proj_out/b"},
+    };
+    for (auto & row : kMap) {
+        if (n == row[0]) { dst = row[1]; return true; }
+    }
+    return false;
+}
