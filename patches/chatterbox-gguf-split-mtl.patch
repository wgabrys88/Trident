+std::string find_codec_companion(const std::string & t3) {
+    namespace fs = std::filesystem;
+    const fs::path dir = fs::path(t3).parent_path();
+    if (!fs::exists(dir)) return {};
+    for (const auto & e : fs::directory_iterator(dir)) {
+        if (!e.is_regular_file()) continue;
+        std::string lo = e.path().filename().string();
+        for (char & c : lo) c = (char)std::tolower((unsigned char)c);
+        if (lo.find("codec") != std::string::npos &&
+            lo.size() >= 5 && lo.compare(lo.size() - 5, 5, ".gguf") == 0) {
+            return e.path().string();
+        }
+    }
+    return {};
+}
+
+ggml_tensor * must(const chatterbox_model & m, const char * name) {
+    auto it = m.tensors.find(name);
+    if (it == m.tensors.end() || !it->second) {
+        throw std::runtime_error(std::string("split-mtl missing tensor: ") + name);
+    }
+    return it->second;
+}
