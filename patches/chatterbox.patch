+std::vector<float> mel_filterbank_24k_80()
+{
+    // Deterministic C++ port of
+    //   librosa.filters.mel(sr=24000, n_fft=1920, n_mels=80, fmin=0, fmax=8000)
+    // (Slaney scale, slaney area norm, htk=False).  The BricksDisplay codec
+    // GGUF does not embed this filterbank, so it is generated at runtime;
+    // computed in double like numpy and rounded to f32 at the end.
+    const int n_fft = 1920, n_mels = 80;
+    const double sr = 24000.0, fmin = 0.0, fmax = 8000.0;
+    const int n_freqs = n_fft / 2 + 1;
+    const double f_sp = 200.0 / 3.0;
+    const double min_log_hz = 1000.0;
+    const double min_log_mel = min_log_hz / f_sp;
+    const double logstep = std::log(6.4) / 27.0;
+    auto hz_to_mel = [&](double f) {
+        return f < min_log_hz ? f / f_sp : min_log_mel + std::log(f / min_log_hz) / logstep;
+    };
+    auto mel_to_hz = [&](double m) {
+        return m < min_log_mel ? m * f_sp : min_log_hz * std::exp(logstep * (m - min_log_mel));
+    };
+    const double lo = hz_to_mel(fmin), hi = hz_to_mel(fmax);
+    std::vector<double> mel_f(n_mels + 2);
+    for (int i = 0; i < n_mels + 2; ++i)
+        mel_f[i] = mel_to_hz(lo + (hi - lo) * (double) i / (n_mels + 1));
+    std::vector<float> fb((size_t) n_mels * n_freqs, 0.0f);
+    for (int m = 0; m < n_mels; ++m) {
+        const double f0 = mel_f[m], f1 = mel_f[m + 1], f2 = mel_f[m + 2];
+        const double enorm = 2.0 / (f2 - f0);
+        for (int k = 0; k < n_freqs; ++k) {
+            const double f = (sr / 2.0) * (double) k / (n_freqs - 1);
+            const double w = std::max(0.0, std::min((f - f0) / (f1 - f0), (f2 - f) / (f2 - f1)));
+            fb[(size_t) m * n_freqs + k] = (float) (w * enorm);
+        }
+    }
+    return fb;
+}
+
 std::vector<float> mel_extract_24k_80(const std::vector<float> & wav_24k,
                                       const std::vector<float> & mel_filterbank)
 {
