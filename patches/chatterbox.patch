+
+std::vector<float> rope_freq_factors(int head_dim, float theta,
+                                     float factor, float low_freq,
+                                     float high_freq, int orig_max_pos) {
+    const int half = head_dim / 2;
+    std::vector<float> ff(half, 1.0f);
+    const float low_wavelen  = (float) orig_max_pos / low_freq;
+    const float high_wavelen = (float) orig_max_pos / high_freq;
+    for (int i = 0; i < half; ++i) {
+        const float base = 1.0f / std::pow(theta, (float)(2 * i) / (float) head_dim);
+        const float wavelen = 2.0f * (float) M_PI / base;
+        float effective;
+        if (wavelen > low_wavelen) {
+            effective = base / factor;
+        } else if (wavelen < high_wavelen) {
+            effective = base;
+        } else {
+            const float smooth = ((float) orig_max_pos / wavelen - low_freq) /
+                                 (high_freq - low_freq);
+            effective = (1.0f - smooth) * (base / factor) + smooth * base;
+        }
+        ff[i] = base / effective;
+    }
+    return ff;
+}
+
+std::string json_escape(const std::string & s) {
+    std::string o;
+    o.reserve(s.size() + 8);
+    for (unsigned char c : s) {
+        if (c == '\\' || c == '"') { o.push_back('\\'); o.push_back((char)c); }
+        else if (c == '\n') o += "\\n";
+        else if (c == '\r') o += "\\r";
+        else if (c == '\t') o += "\\t";
+        else if (c < 0x20) {
+            char buf[8];
+            std::snprintf(buf, sizeof(buf), "\\u%04x", c);
+            o += buf;
+        } else o.push_back((char)c);
+    }
+    return o;
+}
+
+uint32_t kv_u32(const gguf_context * ctx, const char * key, uint32_t fb) {
+    int64_t id = gguf_find_key(ctx, key);
+    return id < 0 ? fb : gguf_get_val_u32(ctx, id);
+}
+float kv_f32(const gguf_context * ctx, const char * key, float fb) {
+    int64_t id = gguf_find_key(ctx, key);
+    return id < 0 ? fb : gguf_get_val_f32(ctx, id);
+}
+bool kv_bool(const gguf_context * ctx, const char * key, bool fb) {
+    int64_t id = gguf_find_key(ctx, key);
+    return id < 0 ? fb : gguf_get_val_bool(ctx, id);
+}
+
+bool remap_t3_name(const char * src, std::string & dst) {
+    const std::string n = src;
+    if (n == "output_norm.weight") { dst = "model/norm/g"; return true; }
+    if (n.rfind("blk.", 0) == 0) {
+        const size_t p2 = n.find('.', 4);
+        if (p2 == std::string::npos) return false;
+        const int idx = std::atoi(n.c_str() + 4);
+        const std::string rest = n.substr(p2 + 1);
+        char buf[80];
+        auto set = [&](const char * fmt) {
+            std::snprintf(buf, sizeof(buf), fmt, idx);
+            dst = buf;
+            return true;
+        };
+        if (rest == "attn_norm.weight")    return set("model/h%d/ln_attn/g");
+        if (rest == "ffn_norm.weight")     return set("model/h%d/ln_mlp/g");
+        if (rest == "attn_q.weight")       return set("model/h%d/attn/q/w");
+        if (rest == "attn_k.weight")       return set("model/h%d/attn/k/w");
+        if (rest == "attn_v.weight")       return set("model/h%d/attn/v/w");
+        if (rest == "attn_output.weight")  return set("model/h%d/attn/o/w");
+        if (rest == "ffn_gate.weight")     return set("model/h%d/mlp/gate/w");
+        if (rest == "ffn_up.weight")       return set("model/h%d/mlp/up/w");
+        if (rest == "ffn_down.weight")     return set("model/h%d/mlp/down/w");
+        return false;
+    }
+    static const char * kMap[][2] = {
+        {"lm.chatterbox.text_emb.weight", "chatterbox/text_emb"},
+        {"lm.chatterbox.text_head.weight", "chatterbox/text_head"},
+        {"lm.chatterbox.text_pos_emb.weight", "chatterbox/text_pos_emb"},
+        {"lm.chatterbox.speech_pos_emb.weight", "chatterbox/speech_pos_emb"},
+        {"lm.audio_embd_0.weight", "chatterbox/speech_emb"},
+        {"lm.heads_0.weight", "chatterbox/speech_head"},
+        {"lm.chatterbox.cond.spkr_enc.weight", "chatterbox/cond_spkr/w"},
+        {"lm.chatterbox.cond.spkr_enc.bias", "chatterbox/cond_spkr/b"},
+        {"lm.chatterbox.cond.emotion_adv_fc.weight", "chatterbox/emotion_adv_fc/w"},
+        {"lm.chatterbox.cond.perceiver.queries", "chatterbox/perceiver/pre_attention_query"},
+        {"lm.chatterbox.cond.perceiver.norm.weight", "chatterbox/perceiver/attn/norm/g"},
+        {"lm.chatterbox.cond.perceiver.norm.bias", "chatterbox/perceiver/attn/norm/b"},
+        {"lm.chatterbox.cond.perceiver.to_q.weight", "chatterbox/perceiver/attn/to_q/w"},
+        {"lm.chatterbox.cond.perceiver.to_q.bias", "chatterbox/perceiver/attn/to_q/b"},
+        {"lm.chatterbox.cond.perceiver.to_k.weight", "chatterbox/perceiver/attn/to_k/w"},
+        {"lm.chatterbox.cond.perceiver.to_k.bias", "chatterbox/perceiver/attn/to_k/b"},
+        {"lm.chatterbox.cond.perceiver.to_v.weight", "chatterbox/perceiver/attn/to_v/w"},
+        {"lm.chatterbox.cond.perceiver.to_v.bias", "chatterbox/perceiver/attn/to_v/b"},
+        {"lm.chatterbox.cond.perceiver.proj_out.weight", "chatterbox/perceiver/attn/proj_out/w"},
+        {"lm.chatterbox.cond.perceiver.proj_out.bias", "chatterbox/perceiver/attn/proj_out/b"},
+    };
+    for (auto & row : kMap) {
+        if (n == row[0]) { dst = row[1]; return true; }
+    }
+    return false;
+}
+
+std::string find_codec_companion(const std::string & t3) {
+    namespace fs = std::filesystem;
+    const fs::path dir = fs::path(t3).parent_path();
+    if (!fs::exists(dir)) return {};
+    for (const auto & e : fs::directory_iterator(dir)) {
+        if (!e.is_regular_file()) continue;
+        std::string lo = e.path().filename().string();
+        for (char & c : lo) c = (char)std::tolower((unsigned char)c);
+        if (lo.find("codec") != std::string::npos &&
+            lo.size() >= 5 && lo.compare(lo.size() - 5, 5, ".gguf") == 0) {
+            return e.path().string();
+        }
+    }
+    return {};
+}
+
+ggml_tensor * must(const chatterbox_model & m, const char * name) {
+    auto it = m.tensors.find(name);
+    if (it == m.tensors.end() || !it->second) {
+        throw std::runtime_error(std::string("split-mtl missing tensor: ") + name);
+    }
+    return it->second;
+}
+
+std::string build_tokenizer_json(const gguf_context * codec) {
+    const int64_t tk = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.tokens");
+    const int64_t mk = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.merges");
+    const int64_t ak = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.added");
+    const int64_t uk = gguf_find_key(codec, "codec.lm.chatterbox.tokenizer.unk_token");
+    if (tk < 0 || mk < 0) {
+        throw std::runtime_error("split-mtl: codec missing tokenizer tokens/merges");
+    }
+    const char * unk = "[UNK]";
+    if (uk >= 0) {
+        const char * u = gguf_get_val_str(codec, uk);
+        if (u) unk = u;
+    }
+    std::ostringstream js;
+    js << "{\"model\":{\"type\":\"BPE\",\"unk_token\":\"" << json_escape(unk) << "\",\"vocab\":{";
+    const size_t ntok = gguf_get_arr_n(codec, tk);
+    for (size_t i = 0; i < ntok; ++i) {
+        const char * t = gguf_get_arr_str(codec, tk, i);
+        if (!t) continue;
+        if (i) js << ',';
+        js << '"' << json_escape(t) << "\":" << i;
+    }
+    js << "},\"merges\":[";
+    const size_t nmer = gguf_get_arr_n(codec, mk);
+    for (size_t i = 0; i < nmer; ++i) {
+        const char * t = gguf_get_arr_str(codec, mk, i);
+        if (!t) continue;
+        if (i) js << ',';
+        js << '"' << json_escape(t) << '"';
+    }
+    js << "]},\"added_tokens\":[";
+    bool first = true;
+    auto emit_added = [&](const std::string & content, int32_t id) {
+        if (!first) js << ',';
+        first = false;
+        js << "{\"content\":\"" << json_escape(content) << "\",\"id\":" << id << '}';
+    };
+    emit_added("[STOP]", (int32_t) kv_u32(codec, "codec.lm.chatterbox.stop_text_token", 0));
+    emit_added("[START]", (int32_t) kv_u32(codec, "codec.lm.chatterbox.start_text_token", 255));
+    emit_added("[UNK]", 1);
+    emit_added("[SPACE]", 2);
+    if (ak >= 0 && gguf_get_kv_type(codec, ak) == GGUF_TYPE_STRING) {
+        const char * added = gguf_get_val_str(codec, ak);
+        if (added) {
+            std::string s = added;
+            size_t pos = 0;
+            while (pos < s.size()) {
+                size_t nl = s.find('\n', pos);
+                if (nl == std::string::npos) nl = s.size();
+                std::string line = s.substr(pos, nl - pos);
+                if (!line.empty() && line.back() == '\r') line.pop_back();
+                // "[STOP]0"
+                size_t i = line.size();
+                while (i > 0 && std::isdigit((unsigned char)line[i - 1])) --i;
+                if (i > 0 && i < line.size()) {
+                    if (!first) js << ',';
+                    first = false;
+                    js << "{\"content\":\"" << json_escape(line.substr(0, i))
+                       << "\",\"id\":" << line.substr(i) << '}';
+                }
+                pos = nl + 1;
+            }
+        }
+    }
+    js << "]}";
+    return js.str();
+}
