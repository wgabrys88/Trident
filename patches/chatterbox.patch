+// Host-side F16/F32 weight read. Vulkan ADD/MUL of F32 activations against
+// an F16 1-D bias reads 4 bytes per element and trips
+// ggml-backend.cpp:307 (nbytes is only 2 bytes/el).
+static void tensor_get_f32(const ggml_tensor * t, std::vector<float> & out) {
+    const size_t n = (size_t) ggml_nelements(t);
+    out.resize(n);
+    if (t->type == GGML_TYPE_F32) {
+        ggml_backend_tensor_get(t, out.data(), 0, ggml_nbytes(t));
+        return;
+    }
+    if (t->type == GGML_TYPE_F16) {
+        std::vector<ggml_fp16_t> tmp(n);
+        ggml_backend_tensor_get(t, tmp.data(), 0, ggml_nbytes(t));
+        for (size_t i = 0; i < n; ++i) out[i] = ggml_fp16_to_fp32(tmp[i]);
+        return;
