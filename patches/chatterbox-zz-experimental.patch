+        writer.add_tensor(name, np.ascontiguousarray(arr.astype(np.float16)) if arr.ndim == 3 else arr)
         return
 
     qdata = gguf.quants.quantize(np.ascontiguousarray(arr.astype(np.float32)), qtype)
