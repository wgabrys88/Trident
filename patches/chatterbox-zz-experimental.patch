# chatterbox.cpp experimental: quantized S3Gen correctness + FASTCONV F32 bake
# Applies last, after chatterbox-trident / sot-eot / pipeline-log.
# - flow/spk_embed_affine/w is consumed as raw dense F32 by chatterbox_tts.cpp,
#   so it must never be block-quantized.
# - Vulkan CONV_TRANSPOSE_1D is F32-only. Rank-3 kernels stay F16 on disk
#   and are baked to F32 at load (TRIDENT_FASTCONV=1) on every profile.

diff --git a/scripts/requantize-gguf.py b/scripts/requantize-gguf.py
--- a/scripts/requantize-gguf.py
+++ b/scripts/requantize-gguf.py
@@ -62,5 +62,6 @@ _DENY_SUBSTRINGS = (
     # Raw-F32 access in the C++ loader
     "flow/input_embedding",     # S3Gen speech embedding table (read as F32 for CPU-side lookup)
+    "flow/spk_embed_affine/w",  # S3Gen speaker affine: fetched as bytes into std::vector<float>
     "/builtin/",                # voice conditioning tensors, loaded directly
     # Embedding tables (accessed via ggml_get_rows — safer as F16/F32)
     "text_emb",                 # T3 text token embedding
diff --git a/scripts/convert-s3gen-to-gguf.py b/scripts/convert-s3gen-to-gguf.py
--- a/scripts/convert-s3gen-to-gguf.py
