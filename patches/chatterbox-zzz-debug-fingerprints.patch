+                        side, ggml_backend_name(be), out.size(), std::sqrt(l2), (double) mn, (double) mx,
+                        (unsigned long long) tts_fnv1a(out.data(), out.size() * sizeof(float)), fin ? 1 : 0);
+                fflush(stderr);
+            }
+            (side ? want : got) = std::move(out);
