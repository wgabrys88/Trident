{
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "description": "Plain sentences for the owner, never device output.",
      "required": ["action", "text"],
      "properties": {
        "action": {"const": "say"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {"action": {"const": "nothing"}}
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "Only a register whose description starts with write.",
      "required": ["action", "address", "register", "text"],
      "properties": {
        "action": {"const": "write"},
        "address": {"const": "00"},
        "register": {"enum": ["00"]},
        "text": {"type": "string"}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "description": "Writes text to the register, then reads its result; the result is your next turn.",
      "required": ["action", "address", "register", "text"],
      "properties": {
        "action": {"const": "read"},
        "address": {"const": "00"},
        "register": {"enum": ["00"]},
        "text": {"type": "string"}
      }
    }
  ]
}
