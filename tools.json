{
  "tools": {
    "screen": {
      "handler": "tools:screen",
      "boundary": false,
      "description": "Capture the desktop and store a PNG. region null is the whole desktop, otherwise native [x, y, width, height]. Read that PNG yourself. A point on the image is not a desktop point: desktop_x = origin_x + image_x / scale_x, and the same for y. This tool does not take observation.",
      "parameters": {
        "type": "object",
        "properties": {"region": {"$ref": "#/$defs/region"}},
        "required": ["region"],
        "additionalProperties": false
      },
      "observe": false
    },
    "images": {
      "handler": "tools:images",
      "boundary": false,
      "description": "Crop stored PNGs and store the new PNG. Read it yourself. Copy path, origin, and scale from a receipt. This tool does not take observation.",
      "parameters": {
        "type": "object",
        "properties": {
          "views": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "origin": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
                "scale": {"$ref": "#/$defs/scale"},
                "region": {"$ref": "#/$defs/region"}
              },
              "required": ["path", "origin", "scale", "region"],
              "additionalProperties": false
            }
          }
        },
        "required": ["views"],
        "additionalProperties": false
      },
      "observe": false
    },
    "click": {
      "handler": "desktop:click",
      "boundary": false,
      "description": "Click desktop pixels. The following shot is a PNG you read yourself.",
      "parameters": {
        "type": "object",
        "properties": {
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "button": {"type": "string", "enum": ["left", "right", "middle"]},
          "count": {"type": "integer", "minimum": 1, "maximum": 2}
        },
        "required": ["x", "y", "button", "count"],
        "additionalProperties": false
      },
      "observe": true
    },
    "drag": {
      "handler": "desktop:stroke",
      "boundary": false,
      "description": "Hold the left button and move through desktop pixel points. The following shot is a PNG you read yourself.",
      "parameters": {
        "type": "object",
        "properties": {
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2}
          },
          "seconds": {"type": "number", "exclusiveMinimum": 0}
        },
        "required": ["points", "seconds"],
        "additionalProperties": false
      },
      "observe": true
    },
    "type_text": {
      "handler": "desktop:type_text",
      "boundary": false,
      "description": "Paste Unicode into the focused control. Establish focus first. The shared observation checks the result.",
      "parameters": {
        "type": "object",
        "properties": {"text": {"type": "string"}},
        "required": ["text"],
        "additionalProperties": false
      },
      "observe": true
    },
    "keys": {
      "handler": "desktop:keys",
      "boundary": false,
      "description": "Press one chord of PyAutoGUI key names. Use another call for the next chord. The shared observation checks the result.",
      "parameters": {
        "type": "object",
        "properties": {"chord": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "required": ["chord"],
        "additionalProperties": false
      },
      "observe": true
    },
    "scroll": {
      "handler": "desktop:scroll",
      "boundary": false,
      "description": "Scroll the focused window by signed wheel ticks, positive upward. The shared observation checks the viewport.",
      "parameters": {
        "type": "object",
        "properties": {"amount": {"type": "integer"}},
        "required": ["amount"],
        "additionalProperties": false
      },
      "observe": true
    },
    "python": {
      "handler": "tools:python",
      "boundary": false,
      "description": "Run the async Python you wrote, with host, ROOT, and asyncio.",
      "parameters": {
        "type": "object",
        "properties": {"code": {"type": "string", "minLength": 1}},
        "required": ["code"],
        "additionalProperties": false
      },
      "observe": false
    },
    "chat": {
      "handler": "line:chat",
      "boundary": false,
      "description": "Send text to Wojciech's private Telegram chat and return its delivery receipt. It does not do desktop work.",
      "parameters": {
        "type": "object",
        "properties": {"text": {"type": "string", "minLength": 1}},
        "required": ["text"],
        "additionalProperties": false
      },
      "observe": false
    },
    "dial": {
      "handler": "tools:dial",
      "boundary": false,
      "description": "Call Wojciech and say text. The wav is synthesized before the phone rings, then played the moment he answers, so the call does not open in silence. Requires transport.call down. If the call is already up, speak instead. An unanswered call returns call down and leaves the process up. The call is not the goal.",
      "parameters": {
        "type": "object",
        "properties": {"text": {"type": "string", "minLength": 1}},
        "required": ["text"],
        "additionalProperties": false
      },
      "observe": false
    },
    "answer": {
      "handler": "line:answer",
      "boundary": false,
      "description": "Accept the ringing call and open audio. Requires transport.call ringing. Ringing is not the owner goal.",
      "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
      "observe": false
    },
    "speak": {
      "handler": "tools:speak",
      "boundary": false,
      "description": "Speak ordered short phrases. While call is up, play them on the call. While call is not up, send each wav as a Telegram audio file he can play. A receipt does not prove he heard it. Hearing keeps transcribing.",
      "parameters": {
        "type": "object",
        "properties": {"parts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}},
        "required": ["parts"],
        "additionalProperties": false
      },
      "observe": false
    },
    "hang": {
      "handler": "line:hang",
      "boundary": false,
      "description": "End the live Telegram call. Requires a current call id. A down call has nothing to hang and this fails. Hanging up keeps the owner goal and open work.",
      "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
      "observe": false
    },
    "files": {
      "handler": "tools:files",
      "boundary": false,
      "description": "Read the files in the Trident root. This tool does not take observation.",
      "parameters": {"type": "object", "properties": {}, "required": [], "additionalProperties": false},
      "observe": false
    },
    "consult": {
      "handler": "tools:consult",
      "boundary": true,
      "description": "Spawn another Luna in agent mode to correct the code when the current tools cannot do the task. Ask mode is not used. She edits the tree. The process then restarts and the call ends. Last call in the batch. This tool does not take observation.",
      "parameters": {
        "type": "object",
        "properties": {"task": {"type": "string", "minLength": 1}},
        "required": ["task"],
        "additionalProperties": false
      },
      "observe": false
    },
    "wait": {
      "handler": "tools:wait",
      "boundary": true,
      "description": "Pause until he speaks or the desktop changes. This tool does not take observation. Last call in the batch.",
      "parameters": {
        "type": "object",
        "properties": {"memory": {"type": "string", "minLength": 1}},
        "required": ["memory"],
        "additionalProperties": false
      },
      "observe": false
    },
    "finish": {
      "handler": "tools:finish",
      "boundary": true,
      "description": "Close the task. completed when you have seen it done. cancelled when he cancelled it. paused keeps it unfinished. shutdown true ends the process and requires the call to be down. Last call in the batch.",
      "parameters": {
        "type": "object",
        "properties": {
          "evidence": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "enum": ["completed", "cancelled", "paused"]},
          "shutdown": {"type": "boolean"}
        },
        "required": ["evidence", "outcome", "shutdown"],
        "additionalProperties": false
      },
      "observe": false
    },
    "goal": {
      "handler": "tools:goal",
      "boundary": false,
      "description": "Name the task his words asked for. Do not name a task from retained open_work unless he just asked for that work. retain_previous true keeps a different unfinished task.",
      "parameters": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "retain_previous": {"type": "boolean"}
        },
        "required": ["text", "retain_previous"],
        "additionalProperties": false
      },
      "observe": false
    }
  },
  "$defs": {
    "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "exclusiveMinimum": 0}},
    "region": {"type": ["array", "null"], "minItems": 4, "maxItems": 4, "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}]},
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessment", "calls"],
      "properties": {
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["approach", "failures", "change"],
          "properties": {
            "approach": {"$ref": "#/$defs/text"},
            "failures": {"type": "array", "items": {"type": "string"}},
            "change": {"$ref": "#/$defs/text"}
          }
        },
        "calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tool", "arguments"],
            "properties": {
              "tool": {"$ref": "#/$defs/text"},
              "arguments": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
