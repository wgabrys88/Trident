# Whitelist. A path is committed only if a rule below un-ignores it.
*

# Allow Git to descend into directories. Files stay ignored until named.
!*/

# !*/ would otherwise expose a nested clone as an embedded gitlink.
/ggml/
/nemo-speech/
/llama-vulkan/
/build/
/models/
/.venv/
/.ckpt/
/.ckpt-v3/
/wav/
/gemma/llama.cpp/
/gemma/build/
/gemma/models/
/gemma/cmake/HostCpu.generated.cmake
/.install/

!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/LICENSE
!/install.py
!/utf8.manifest
!/install.txt
!/vad.txt
!/ear.txt
!/sense.txt
!/gemma.txt
!/chatterbox.txt
!/bake.txt
!/mouth.py
!/lan-recon/collect_iris_inventory.py
!/hear.py
!/gemma.py
!/qwen.py
!/assistant.py
!/CPP_DELTA_FINDINGS.md
!/reference.wav
!/CODE_REVIEW_CHECKLIST.md
!/BOTS.md

!/scripts/convert_s3.py
!/scripts/convert_t3.py
!/scripts/quant.py
!/scripts/quant_s3.json
!/scripts/quant_t3.json

!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.hpp

!/gemma/.gitignore
!/gemma/CMakeLists.txt
!/gemma/cmake/HostCpu.cmake
!/gemma/scripts/detect_cpu.ps1
!/gemma/scripts/detect_gpu.ps1
!/gemma/src/brain.cpp
!/gemma/src/sense.cpp

!/artifacts/reference/desktop_ui_reference.png
!/artifacts/reference/DESKTOP_UI_REFERENCE.md
!/artifacts/reference/tts_chunk_mixed_pl_en.txt
!/artifacts/reference/TTS_CHUNK_MIXED_PL_EN.md

# Resident slots, one-shot artifacts, and run logs.
# mouth.py, hear.py, gemma.py, qwen.py, assistant.py, and BOTS.md stay tracked. A later un-ignore must not commit these.
/mouth.txt
/gemma_run.txt
/sense_run.txt
/*_out_*.txt
/*_chatterbox_out_*
/*.pid
/*.stop
/*.prompt.txt
/*.response.txt
/*.response.wav
/*.history.txt
/*.run.log
/*.run.err
