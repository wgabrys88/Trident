# Whitelist. A path is committed only if a rule below un-ignores it.
*

# Allow Git to descend into directories. Files stay ignored until named.
!*/

# Generated and downloaded. A clone builds these with install.py.
/.venv/
/.install/
/build/
/models/
/ggml/
/nemo-speech/
/llama-vulkan/
/.ckpt/
/.ckpt-v3/
/wav/
/gemma/llama.cpp/
/gemma/build/
/gemma/models/
/gemma/cmake/HostCpu.generated.cmake

# Sources a fresh clone needs in order to install and rebuild.
!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/LICENSE
!/install.py
!/install.txt
!/utf8.manifest
!/vad.txt
!/gemma.txt
!/chatterbox.txt
!/bake.txt
!/run.py
!/hear.py
!/gemma.py
!/mouth.py
!/call.py
!/node.py
!/win32.py
!/inject.py
!/reference.wav

# Installer conversion and quantization.
!/scripts/convert_s3.py
!/scripts/convert_t3.py
!/scripts/quant.py
!/scripts/quant_s3.json
!/scripts/quant_t3.json

# Native source.
!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.hpp

# Gemma and Qwen native build source.
!/gemma/CMakeLists.txt
!/gemma/cmake/HostCpu.cmake
!/gemma/scripts/detect_cpu.ps1
!/gemma/scripts/detect_gpu.ps1
!/gemma/src/brain.cpp

# Trident v2 lives in its own folder with its own .gitignore.
!/Trident-v2/**

# Runtime files the programs rewrite.
/mouth.txt
/mouth.v3.txt
/gemma_run.txt
/sense_run.txt
/*_out_*.txt
/*_chatterbox_out_*
/*.pid
/*.stop
/*.prompt.txt
/*.response.txt
/*.response.wav
/*.history.txt
/*.run.log
/*.run.err
/tool_hello.txt
/gemma.memory.txt
/gemma.memory.txt.tmp
/gemma.lastprompt.txt
/vad.hold
/vad.utterance.txt
/vad_run.txt
