# Whitelist. A path is committed only if a rule below un-ignores it.
*

# Allow Git to descend into directories. Files stay ignored until named.
!*/

# Generated/install-only directories.
/.venv/
/.install/
/build/
/models/
/ggml/
/nemo-speech/
/llama-vulkan/
/.ckpt/
/.ckpt-v3/
/wav/
/gemma/llama.cpp/
/gemma/build/
/gemma/models/
/gemma/cmake/HostCpu.generated.cmake

# Repository root.
!/.gitignore
!/.gitattributes
!/README.md
!/CMakeLists.txt
!/LICENSE
!/install.py
!/install.txt
!/utf8.manifest
!/vad.txt
!/ear.txt
!/sense.txt
!/gemma.txt
!/chatterbox.txt
!/bake.txt
!/assistant.py
!/hear.py
!/qwen.py
!/gemma.py
!/mouth.py
!/loopback.py
!/loopback-proof/*.txt
!/nvidia_client.py
!/nvidia_worker.py
!/seq_agents.py
!/parallel_agents.py
!/parallel_agents.txt
!/parallel_agents.log
!/reference.wav

# Installer conversion/quantization tools.
!/scripts/convert_s3.py
!/scripts/convert_t3.py
!/scripts/quant.py
!/scripts/quant_s3.json
!/scripts/quant_t3.json

# Native source.
!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.hpp

# Gemma/Qwen native build source.
!/gemma/CMakeLists.txt
!/gemma/cmake/HostCpu.cmake
!/gemma/scripts/detect_cpu.ps1
!/gemma/scripts/detect_gpu.ps1
!/gemma/src/brain.cpp
!/gemma/src/sense.cpp

# Resident slots, one-shot artifacts, and run logs.
/mouth.txt
/gemma_run.txt
/sense_run.txt
/nvidia_turn.request.txt
/nvidia_turn.request.txt.tmp
/nvidia_turn.response.txt
/nvidia_turn.response.txt.tmp
/*_out_*.txt
/*_chatterbox_out_*
/*.pid
/*.stop
/*.prompt.txt
/*.response.txt
/*.response.wav
/*.history.txt
/*.run.log
/*.run.err

# Grok-bot team. Role and memory live in these files. The worker stays stateless.
!/grok_local_bot.py
!/grok_bot.txt
!/grok_bot_history.txt
!/grok_bot_request.txt
!/grok_bot_response.txt
!/grok_bot_spawn.txt
!/iris-door.txt
