# Whitelist. A path is committed only if a rule below un-ignores it.
*

# Allow Git to descend into directories. Files stay ignored until named.
!*/

# !*/ would otherwise expose a nested clone as an embedded gitlink.
/ggml/
/nemo-speech/
/llama-vulkan/
/build/
/models/
/.venv/
/.ckpt/
/.ckpt-v3/
/wav/
/gemma/llama.cpp/
/gemma/build/
/gemma/models/
/gemma/cmake/HostCpu.generated.cmake
/.install/

!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/LICENSE
!/install.py
!/utf8.manifest
!/install.txt
!/vad.txt
!/ear.txt
!/sense.txt
!/gemma.txt
!/chatterbox.txt
!/bake.txt
!/reference.wav
!/CODE_REVIEW_CHECKLIST.md

!/scripts/convert_s3.py
!/scripts/convert_t3.py
!/scripts/quant.py
!/scripts/quant_s3.json
!/scripts/quant_t3.json

!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.hpp

!/gemma/.gitignore
!/gemma/CMakeLists.txt
!/gemma/cmake/HostCpu.cmake
!/gemma/scripts/detect_cpu.ps1
!/gemma/scripts/detect_gpu.ps1
!/gemma/src/brain.cpp
!/gemma/src/sense.cpp

# Resident slots and run logs. A later un-ignore must not commit these.
/*.pid
/*.stop
/*.prompt.txt
/*.response.txt
/*.response.wav
/*.history.txt
/*.run.log
/*.run.err
