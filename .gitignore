# Whitelist. A path is committed only if a rule below un-ignores it.
*

# Allow Git to descend into directories. Files stay ignored until named.
!*/

# Generated and local. The exes and models stay beside the checkout.
/.venv/
/.install/
/build/
/models/
/ggml/
/nemo-speech/
/llama-vulkan/
/.ckpt/
/.ckpt-v3/
/wav/
/gemma/

# Sources.
!/.gitignore
!/.gitattributes
!/LICENSE
!/vad.txt
!/sense.txt
!/gemma.txt
!/chatterbox.txt
!/assistant.py
!/run.py
!/hear.py
!/qwen.py
!/gemma.py
!/mouth.py
!/seat.py
!/nvidia_client.py
!/nvidia_worker.py
!/nvidia_start.py
!/nvidia_stop.py

