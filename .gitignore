# Whitelist. A path is committed only if a rule below un-ignores it.
*

# Allow Git to descend into directories. Files stay ignored until named.
!*/

!/.gitignore
!/.gitattributes
!/CMakeLists.txt
!/LICENSE
!/install.py
!/reference.wav
!/requirements.txt

!/scripts/convert_s3.py
!/scripts/convert_t3.py
!/scripts/quant.py
!/scripts/quant_s3.json
!/scripts/quant_t3.json

!/src/**/*.cpp
!/src/**/*.h
!/src/**/*.hpp

!/gemma/.gitignore
!/gemma/CMakeLists.txt
!/gemma/cmake/HostCpu.cmake
!/gemma/cmake/Pascal1060.cmake
!/gemma/cmake/PascalCuda.cmake
!/gemma/scripts/build.ps1
!/gemma/scripts/configure.ps1
!/gemma/scripts/detect_cpu.ps1
!/gemma/src/brain.cpp
